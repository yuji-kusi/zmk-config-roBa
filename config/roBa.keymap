#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
// マウスキーの速さ（初期値 600 より少しゆっくり。細かい位置合わせは J を押さえてボール）
#define ZMK_POINTING_DEFAULT_MOVE_VAL 450
#define ZMK_POINTING_DEFAULT_SCRL_VAL 10
#include <dt-bindings/zmk/pointing.h>

// 面の番号: 0 ふだん / 1 数字と F キー / 2 記号と矢印 / 3 Mac 操作・メディア / 4 マウス / 5 スクロール / 6 ドラッグ中（ボールをゆっくり）
// 4・5・6 は &trackball の automouse-layer・scroll-layers・snipe-layers が指しているので番号を変えない
// 親指は串田さんの呼び方に合わせる: 「外側」＝中央寄り（斜めに傾いたキー）。
// 左親指 中央寄りから 英かな（軽押しで Control+Space）／長押し Option・Space（長押し Command）・Tab、右親指 中央寄りから Enter・delete（Backspace）（第 38 版で入れ替え。長押しはキーと一緒に動かした）
// スクロール: I・N・/ の長押し（使いやすいのを試す）、または右下の角（前方削除）の長押しをしながらボール
// 入り方: 1 C の真下を押さえている間（X の真下は空き）、または右親指の delete（Backspace）の長押し / 2 右親指の Enter の長押し / 3 Z の真下を押さえている間、または左の B・右の P の長押し

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    automouse-layer = <4>;
    scroll-layers = <5>;
    snipe-layers = <6>;
};

/ {
    macros {
        // 受け取ったキーを 1 回だけ打つ（長押しで ⌘C などを 1 回だけ出す。押し続けても繰り返さない）
        tap_once: tap_once {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&macro_param_1to1>, <&macro_tap &kp MACRO_PLACEHOLDER>;
        };

        // 左クリックを押さえている間だけドラッグ中の面（6）に入り、ボールをゆっくりにする（選ぶ範囲の微調整用）
        slow_drag: slow_drag {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings
                = <&macro_press &mo 6 &mkp MB1>
                , <&macro_pause_for_release>
                , <&macro_release &mkp MB1 &mo 6>
                ;
        };
    };

    behaviors {
        // G（長押し Control+Command）と G の右隣（軽押しは何も出さない・長押し Command+Shift。押さえて T で CleanShot の文字の写し取り）。
        // G の右隣の軽押しは Mission Control だったが、誤って押しやすいので第 39 版で外した（Mission Control は Mac 操作の面の J の位置にある）
        // G+T のように同じ左手のキーとも組めるよう、手の左右を問わない。0.25 秒押さえたときだけ長押し、打った直後 0.15 秒以内は必ず軽押し
        ghm: g_hold_mod {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "tap-preferred";
            tapping-term-ms = <250>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
        };

        // G の右隣用: 軽押しは何も出さない（&none）、長押しだけ働く。押し方の決め方は上の ghm と同じ
        ghn: g_hold_only {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&none>;
            flavor = "tap-preferred";
            tapping-term-ms = <250>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
        };

        // 文字キーの長押しでよく使う操作（Q Esc、S ⌘S、F Alfred＝Command+Space、X ⌘X、C ⌘C、V ⌘V）。
        // 速打ちで誤って出ないよう、文字を打った直後 0.15 秒以内は必ず文字、長押しは 0.3 秒
        sct: shortcut_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&tap_once>, <&kp>;
            flavor = "tap-preferred";
            tapping-term-ms = <300>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
        };

        // ホームの段の長押し: A Shift・D Control+Option（D を押さえて Space・Enter で Orca の会話の開始・送信など）、右は ' Shift。
        // 反対の手のキーと親指にだけ効く。
        // 速打ちで誤って働かないように: 文字を打った直後 0.15 秒以内は必ず文字、0.25 秒押さえたうえで反対の手のキー（と親指）を押したときだけ修飾キー
        lhs: left_home_shift {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <250>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <5 6 7 8 9 16 17 18 19 20 21 28 29 30 31 32 33 37 38 39 40 41 42>;
            hold-trigger-on-release;
        };

        rhs: right_home_shift {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <250>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 15 22 23 24 25 26 27 34 35 36 37 38 39 40 41 42>;
            hold-trigger-on-release;
        };

        // 左親指の真ん中の Space: 長押しで Command。Command+C などを素早く打てるよう balanced にし、
        // 文字を打った直後 0.15 秒以内は必ず Space（速打ちで Command+文字 に化けないように）
        tmt: thumb_mod_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <220>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <150>;
            // 長く押しても他のキーを押さずに離したら Space として出す
            retro-tap;
        };

        // 左親指のいちばん端（軽押し Tab・長押し Control）と中央寄り（軽押し 英かな・長押し Option）。
        // 修飾キーを素早く使えるよう balanced にする。軽押しのすぐ後の押し続けは前方削除の連続
        cmt: quick_mod_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
        };

        // 内側の列の 2 役キー（N の左隣: 軽押し B・長押し 音声入力、B の右隣: 軽押し 取り消し・長押し やり直し）。
        // 長押しは 0.3 秒としっかり長めに。文字を打った直後 0.15 秒以内は必ず軽押し
        vbs: slow_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "tap-preferred";
            tapping-term-ms = <300>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <150>;
        };

        // 長押しで面に入るキー: 右親指の delete（Backspace）で数字と F キーの面、Enter で記号と矢印の面、左の B で Mac 操作の面。
        // 長押しして何も打たずに離しても delete・Enter・B は出さない（文字を消さない・誤って送信しない）。文字を打った直後 0.15 秒以内は必ず軽押し
        blt: right_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <150>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&sct ESC Q        &kp W     &kp E     &kp R              &kp T                                                                   &kp Y      &kp U  &lt 5 I    &kp O    &lt 3 P
&lhs LSHIFT A     &sct LG(S) S &lhs LC(LALT) D &sct LG(SPACE) F                  &ghm LC(LGUI) G                   &ghn LG(LSHIFT) 0               &kp MINUS                     &kp H  &kp J  &kp K  &kp L  &rhs LSHIFT SQT
&kp Z             &sct LG(X) X &sct LG(C) C &sct LG(V) V            &blt 3 B            &vbs LS(LG(Z)) LG(Z)  &vbs LG(PERIOD) B            &lt 5 N    &kp M  &kp COMMA  &kp DOT  &lt 5 SLASH
&mo 3             &none       &mo 1          &cmt LCTRL TAB       &tmt LGUI SPACE  &cmt LALT LC(SPACE) &blt 2 ENTER              &blt 1 BACKSPACE                                      &lt 5 DELETE
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        // 数字と F キーの面（C の真下を押さえている間か、右親指の delete の長押し）。左手に F キー、右手にテンキーの並び（第 41 版から、送るのはテンキーではなく上の段の普通の数字。⌘1 などのショートカットが確実に効くように）
        NUM_F {
            bindings = <
&kp F1   &kp F2   &kp F3   &kp F4   &none                                                 &kp MINUS        &kp N7           &kp N8           &kp N9           &kp PLUS
&kp F5   &kp F6   &kp F7   &kp F8   &none    &none                       &none            &kp SLASH        &kp N4           &kp N5           &kp N6           &kp ASTERISK
&kp F9   &kp F10  &kp F11  &kp F12  &none    &none                       &kp EQUAL        &kp N0           &kp N1           &kp N2           &kp N3           &kp PERIOD
&trans   &trans   &trans   &trans   &trans   &trans                      &trans           &trans                                                              &trans
            >;
        };

        // 記号と矢印の面（右親指の Enter の長押し）。A の位置は軽押し #・長押し Shift（Enter を押さえた後から Shift を足して H J K L で選ぶ）。Y の位置は ;（動画の図では /。/ はふだんの面にある）。動画の配列図の Layer 2 の並び（^ と _ は人差し指の内側、Home・End は下の段の内側）
        SYMBOL {
            bindings = <
&kp QUESTION  &kp EXCLAMATION   &kp AMPERSAND      &kp PIPE          &kp BACKSLASH                                                  &kp SEMICOLON          &kp EQUAL          &kp ASTERISK      &kp PLUS          &kp PERCENT
&lhs LSHIFT HASH &kp GRAVE        &kp DOUBLE_QUOTES  &kp SINGLE_QUOTE  &kp TILDE             &kp CARET      &kp UNDERSCORE           &kp LEFT_ARROW         &kp DOWN_ARROW     &kp UP_ARROW      &kp RIGHT_ARROW   &kp COLON
&kp AT_SIGN   &kp LESS_THAN     &kp LEFT_BRACE     &kp LEFT_BRACKET  &kp LEFT_PARENTHESIS  &kp HOME       &kp END                  &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACKET  &kp RIGHT_BRACE   &kp GREATER_THAN  &kp DOLLAR
&trans        &trans            &trans             &trans            &kp DELETE            &trans         &trans                   &trans                                                                           &trans
            >;
        };

        // Mac 操作・メディアの面（Z の真下を押さえている間か、左の B・右の P の長押し）。右手は画面の操作と撮影、左手は音楽・アプリを開くキー・Bluetooth。
        // アプリを開くキー（A Notion・S Orca・D Finder・F Google Chrome・G Chatwork・G の右隣 LINE）は Control+Option+Command+Shift+1〜6 を送る（Notion 1・Orca 2・Finder 3・LINE 4・Chatwork 5・Chrome 6）。開く設定は Mac 側（BetterTouchTool）で
        // 右手の中の段は外から 左のタブ・左のデスクトップ・Mission Control・右のデスクトップ・右のタブ（' の位置は空き）
        // 撮影は CleanShot の設定に合わせる（N 範囲 Shift+Cmd+4、M 全画面 3、, 画面の文字 T、/ 撮影メニュー 0）。. の CleanShot の履歴は Control+Option+Command+Shift+7 を BetterTouchTool で cleanshot://open-history に
        MAC_MEDIA {
            bindings = <
&none   &kp C_PREV    &kp C_PP      &kp C_NEXT    &kp LG(SLASH)                                     &kp C_BRI_DN       &kp C_BRI_UP        &kp C_VOL_DN      &kp C_VOL_UP         &kp C_MUTE
&kp LC(LA(LG(LS(N1))))  &kp LC(LA(LG(LS(N2))))  &kp LC(LA(LG(LS(N3))))  &kp LC(LA(LG(LS(N6))))  &kp LC(LA(LG(LS(N5))))  &kp LC(LA(LG(LS(N4))))  &kp LC(LS(TAB))    &kp LC(LEFT_ARROW) &kp LC(UP_ARROW)  &kp LC(RIGHT_ARROW)  &kp LC(TAB)  &none
&none   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_CLR     &kp LA(LS(LG(V)))  &kp LS(LG(N4))     &kp LS(LG(N3))      &kp LS(LG(T))     &kp LC(LA(LG(LS(N7))))  &kp LS(LG(N0))
&trans  &trans        &trans        &trans        &trans        &trans         &trans             &trans                                                                   &trans
            >;
        };

        // マウスの面（ボールを動かした後 1.5 秒）。J 左クリック（押さえている間ボールがゆっくり）・L 右クリック（第 39 版で K から L へ。K は文字のまま）
        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &slow_drag  &trans    &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                &trans
            >;
        };

        // スクロールの面（I・N・/ か右下の角を押さえている間。ボールでスクロール）。
        // 押さえている間は J 左クリック（押さえている間ボールがゆっくり）・L 右クリックが時間切れなしで使える。
        // マウスキー: 左手の E S D F でカーソルを ↑ ← ↓ →、R で上へ・V で下へスクロール（Mac のナチュラルなスクロールに合わせて SCRL_DOWN・SCRL_UP を逆に割り当て）。U 左クリック、O 右クリック
        // 拡大・縮小（タッチパッドのピンチの代わり）: T 拡大 Command+=、G 縮小 Command+-、B 元の大きさ Command+0
        SCROLL {
            bindings = <
&trans  &trans          &mmv MOVE_UP    &msc SCRL_DOWN   &kp LG(EQUAL)               &trans  &mkp MB1  &trans    &mkp MB2  &trans
&trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &kp LG(MINUS)  &trans      &trans  &trans  &slow_drag  &trans    &mkp MB2  &trans
&trans  &trans          &trans          &msc SCRL_UP     &kp LG(N0)     &trans      &trans  &trans  &trans    &trans    &trans    &trans
&trans  &trans          &trans          &trans           &trans  &trans      &trans  &trans                                &trans
            >;
        };

        // ドラッグ中の面（J の左クリックを押さえている間だけ。中身はすべて下の面のまま、ボールが半分の速さになる）
        SLOW_DRAG {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

    };
};

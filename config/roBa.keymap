#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
// マウスキーの速さ（初期値 600 より少しゆっくり。細かい位置合わせは J を押さえてボール）
#define ZMK_POINTING_DEFAULT_MOVE_VAL 450
#define ZMK_POINTING_DEFAULT_SCRL_VAL 10
#include <dt-bindings/zmk/pointing.h>

// 面の番号（第 61 版で付け直し）: 0 ふだん / 1 英かなの切り替え用（かなを送った後） / 2 数字＋よく使う記号＋矢印 / 3 余った記号と F キー / 4 Mac 操作・メディア / 5 マウス / 6 スクロール / 7 ドラッグ中（ボールをゆっくり）
// 5・6・7 は &trackball の automouse-layer・scroll-layers・snipe-layers が指している（ドライバはいちばん上の面で判定する）
// 親指は串田さんの呼び方に合わせる: 「外側」＝中央寄り（斜めに傾いたキー）。
// 左親指 中央寄りから 英かな（Control+Space。第 49 版で長押しの Option を外した）・Space（長押し Command）・Tab（長押し Control）。左の下の段 B の右隣 Shift（第 50 版）・X の真下 Option・C の真下 Command（押さえている間。第 49 版）。右親指 中央寄りから delete（Backspace）・Enter（第 49 版で入れ替え。長押しはキーと一緒に動かした）
// スクロール: / の長押し・左親指の英かなの長押し（第 50 版で B の右隣から移した。B の右隣は Shift に。A と ' の長押しの Shift は外した）（I は Mac 操作の面へ、N は第 49 版で長押し無し）（使いやすいのを試す）、または右下の角（前方削除）の長押しをしながらボール
// 第 52 版: X の真下 Option・C の真下 Control（第 55 版で入れ替え）・左親指は外から Space（長押し Command）・Tab（長押し Mac 操作の面）（第 54 版で軽押しの Space と Tab を入れ替え。長押しは場所のまま）・S の長押し Command+Shift。B と / の長押しは外した（第 51 版）
// 第 56 版: J の長押し Control・K の長押し Option（右手の 2 役は左手か親指のキーと一緒のときだけ長押しになる＝rhs）
// 第 57 版: 左親指の Tab の長押しを Shift、B の右隣を押さえている間 Mac 操作の面（前は Shift）、右親指の Enter と delete を長押しごと元に戻す（中央寄り Enter＝記号と矢印、隣 delete＝数字と F）
// 第 58 版: B の長押しで Mac 操作の面、取り消し・やり直しを G の右隣から B の右隣へ（G の右隣は空き）
// 第 60 版: G の右隣にアプリ切替（押している間 Command を押さえて Tab を 1 回。押したまま左親指の Tab で次へ・ボールで合わせて選ぶ、離すと切り替わる。軽押しは直前のアプリへ）
// 第 61 版: 面の組み替え。1 Enter の長押し＝数字（左手に電卓の並び、F が 5、0 は Space の位置）＋よく使う記号＋矢印 / 2 B の長押し＝余った記号と F1〜F12 / 3 delete の長押し＝Mac 操作の面（Z の真下・' の長押しからも）。Home・End は外した。
// 第 61 版: 英かなは押すたびに かな（LANG1）と 英数（LANG2）を交互に送る（前は Control+Space＝前の入力ソース。続けて押すと全角英字などへ飛んだ）。どちらを送ったかはキーボードが覚える（面 1 の入・切）。ずれたら 1 回余分に押せば合う
// 第 63 版: P の長押しで Mac 操作の面（' の長押しから移した）、' の長押しは Shift に戻した（rhs＝左手か親指のキーと一緒のときだけ）。Enter の面の / は BetterTouchTool で文字を入れる（かなのままでも半角の / が出る）
// 第 64 版: 左親指の Space と Tab の軽押しを入れ替え（外から Tab（長押し Command）・Space（長押し Shift）・英かな）。長押しは場所のまま
// 第 70 版: Alfred 用のキーは押すだけで Alfred を開いて言葉まで打つ。B の長押しの面の左 Q sp・W spn・A dq・S dqn・Z gc を追加。Mac 操作の面の E Meet・R スニペット（Option+S）・T クリップボード履歴（Command+H）
// 第 69 版: B の長押しの面の右の中の段を H の左隣 fna・H cw・J bm・K cal・L ls・' td（ToDo 登録＝Alfred を開いて「td 」まで打つ）に並べ替え。$ はふだんの面の U の長押しへ
// 第 67 版: I の長押しをスクロールから Mac 操作の面に（左手のキーと一緒のときだけ）。B の長押しの面の H J K L ' に Alfred 用の文字、$ は H の左隣へ
// 入り方: 1 右親指の Enter の長押し / 2 左の B の長押し / 3 右親指の delete の長押し、Z の真下を押さえている間、右の P の長押し / 7 かなを送った後（英かなの次の 1 回を英数にするだけ）

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    automouse-layer = <5>;
    scroll-layers = <6>;
    snipe-layers = <7>;
};

/ {
    macros {
        // 受け取ったキーを 1 回だけ打つ（長押しで ⌘C などを 1 回だけ出す。押し続けても繰り返さない）
        tap_once: tap_once {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&macro_param_1to1>, <&macro_tap &kp MACRO_PLACEHOLDER>;
        };

        // 左クリックを押さえている間だけドラッグ中の面（6）に入り、ボールをゆっくりにする（選ぶ範囲の微調整用）
        slow_drag: slow_drag {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings
                = <&macro_press &mo 7 &mkp MB1>
                , <&macro_pause_for_release>
                , <&macro_release &mkp MB1 &mo 7>
                ;
        };

        // 英かな（第 61 版）: かな（LANG1）を送って面 1 を入れる → 次の 1 回は英数（LANG2）を送って面 1 を切る。受け取る数は使わない
        to_kana: to_kana {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&macro_tap &kp LANG1 &tog 1>;
        };

        to_eisu: to_eisu {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&macro_tap &kp LANG2 &tog 1>;
        };

        // アプリ切替（第 60 版、G の右隣）: 押した瞬間に Command を押さえて Tab を 1 回 → アプリのアイコンが並ぶ。
        // 押している間は Command を押さえたまま（左親指の Tab で次のアプリ、英かなの長押し Shift と一緒に Tab で前へ、ボールでアイコンに合わせても選べる）。
        // 離すと Command も離れて、選んだアプリに切り替わる。軽く押すだけなら直前のアプリへ。
        // 第 31 版の tri-state（&kt で Command を押しっぱなしにする作り）は Command が押されたまま残ったので使わない。押す・離すがキーの押す・離すと必ず対になる作り
        // 長押しで使えるよう数を 1 つ受け取る形にしたもの（数は使わない。第 75 版、delete の長押し）
        app_switch_p: app_switch_p {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            wait-ms = <0>;
            tap-ms = <30>;
            bindings
                = <&macro_press &kp LGUI>
                , <&macro_tap &kp TAB>
                , <&macro_pause_for_release>
                , <&macro_release &kp LGUI>
                ;
        };

        app_switch: app_switch {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <30>;
            bindings
                = <&macro_press &kp LGUI>
                , <&macro_tap &kp TAB>
                , <&macro_pause_for_release>
                , <&macro_release &kp LGUI>
                ;
        };

        // 第 70 版: Alfred をキーひとつで呼ぶ（第 67・69 版の文字マクロをこの形にそろえた。私用）。
        // 英数（LANG2）にそろえ英かなの記憶（面 1）も切る → Command+Space で Alfred を開く → 0.3 秒待つ → もう一度英数 → 言葉と空白を打つ（Enter は付けない）。
        // 先に F の長押しで Alfred を開いてから押すと、Command+Space で逆に閉じる。
        str_bm: str_bm {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <10>;
            bindings = <&macro_tap &kp LANG2 &tog_off 1>, <&macro_wait_time 30>, <&macro_tap &kp LG(SPACE)>, <&macro_wait_time 300>, <&macro_tap &kp LANG2>, <&macro_wait_time 30>, <&macro_tap &kp B &kp M &kp SPACE>;
        };

        str_cal: str_cal {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <10>;
            bindings = <&macro_tap &kp LANG2 &tog_off 1>, <&macro_wait_time 30>, <&macro_tap &kp LG(SPACE)>, <&macro_wait_time 300>, <&macro_tap &kp LANG2>, <&macro_wait_time 30>, <&macro_tap &kp C &kp A &kp L &kp SPACE>;
        };

        str_fna: str_fna {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <10>;
            bindings = <&macro_tap &kp LANG2 &tog_off 1>, <&macro_wait_time 30>, <&macro_tap &kp LG(SPACE)>, <&macro_wait_time 300>, <&macro_tap &kp LANG2>, <&macro_wait_time 30>, <&macro_tap &kp F &kp N &kp A &kp SPACE>;
        };

        str_cw: str_cw {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <10>;
            bindings = <&macro_tap &kp LANG2 &tog_off 1>, <&macro_wait_time 30>, <&macro_tap &kp LG(SPACE)>, <&macro_wait_time 300>, <&macro_tap &kp LANG2>, <&macro_wait_time 30>, <&macro_tap &kp C &kp W &kp SPACE>;
        };

        str_ls: str_ls {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <10>;
            bindings = <&macro_tap &kp LANG2 &tog_off 1>, <&macro_wait_time 30>, <&macro_tap &kp LG(SPACE)>, <&macro_wait_time 300>, <&macro_tap &kp LANG2>, <&macro_wait_time 30>, <&macro_tap &kp L &kp S &kp SPACE>;
        };

        str_td: str_td {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <10>;
            bindings = <&macro_tap &kp LANG2 &tog_off 1>, <&macro_wait_time 30>, <&macro_tap &kp LG(SPACE)>, <&macro_wait_time 300>, <&macro_tap &kp LANG2>, <&macro_wait_time 30>, <&macro_tap &kp T &kp D &kp SPACE>;
        };

        str_sp: str_sp {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <10>;
            bindings = <&macro_tap &kp LANG2 &tog_off 1>, <&macro_wait_time 30>, <&macro_tap &kp LG(SPACE)>, <&macro_wait_time 300>, <&macro_tap &kp LANG2>, <&macro_wait_time 30>, <&macro_tap &kp S &kp P &kp SPACE>;
        };

        str_spn: str_spn {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <10>;
            bindings = <&macro_tap &kp LANG2 &tog_off 1>, <&macro_wait_time 30>, <&macro_tap &kp LG(SPACE)>, <&macro_wait_time 300>, <&macro_tap &kp LANG2>, <&macro_wait_time 30>, <&macro_tap &kp S &kp P &kp N &kp SPACE>;
        };

        str_dq: str_dq {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <10>;
            bindings = <&macro_tap &kp LANG2 &tog_off 1>, <&macro_wait_time 30>, <&macro_tap &kp LG(SPACE)>, <&macro_wait_time 300>, <&macro_tap &kp LANG2>, <&macro_wait_time 30>, <&macro_tap &kp D &kp Q &kp SPACE>;
        };

        str_dqn: str_dqn {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <10>;
            bindings = <&macro_tap &kp LANG2 &tog_off 1>, <&macro_wait_time 30>, <&macro_tap &kp LG(SPACE)>, <&macro_wait_time 300>, <&macro_tap &kp LANG2>, <&macro_wait_time 30>, <&macro_tap &kp D &kp Q &kp N &kp SPACE>;
        };

        str_gc: str_gc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <10>;
            bindings = <&macro_tap &kp LANG2 &tog_off 1>, <&macro_wait_time 30>, <&macro_tap &kp LG(SPACE)>, <&macro_wait_time 300>, <&macro_tap &kp LANG2>, <&macro_wait_time 30>, <&macro_tap &kp G &kp C &kp SPACE>;
        };

    };

    behaviors {
        // 面を必ず切る（押すたびに入れ替えではなく、切るだけ）。Alfred 用の文字の前に英かなの記憶を「英数」にそろえる
        tog_off: toggle_layer_off {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            toggle-mode = "off";
        };

        // 英かな（第 61 版、左親指の中央寄り）: 軽押しは かな と 英数 を交互に、長押しは Mac 操作の面（第 76 版。第 71〜75 版は Shift、その前はボールでスクロール）
        ekk: eikana_kana {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&to_kana>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
        };

        eke: eikana_eisu {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&to_eisu>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
        };

        // G（長押し Control+Command）。G の右隣の長押し Command+Shift は第 48 版で外した（G の右隣は取り消し・やり直しに。CleanShot の文字の写し取りは Mac 操作の面の , ）。
        // G の右隣の軽押しは Mission Control だったが、誤って押しやすいので第 39 版で外した（Mission Control は Mac 操作の面の J の位置にある）
        // G+T のように同じ左手のキーとも組めるよう、手の左右を問わない。0.25 秒押さえたときだけ長押し、打った直後 0.15 秒以内は必ず軽押し
        ghm: g_hold_mod {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "tap-preferred";
            tapping-term-ms = <250>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
        };

        // 軽押しは何も出さない（&none）、長押しだけ働く 2 役キー。第 48 版から使っている所は無い
        ghn: g_hold_only {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&none>;
            flavor = "tap-preferred";
            tapping-term-ms = <250>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
        };

        // 文字キーの長押しでよく使う操作（Q Esc、F Alfred＝Command+Space、第 61 版で W ⌘W・X ⌘X・C ⌘C・V ⌘V を戻した、第 69 版で U の長押しに $）。S・X・C・V の長押し（⌘S・⌘X・⌘C・⌘V）は分かりにくいので第 43 版で外した。
        // 速打ちで誤って出ないよう、文字を打った直後 0.15 秒以内は必ず文字、長押しは 0.3 秒
        sct: shortcut_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&tap_once>, <&kp>;
            flavor = "tap-preferred";
            tapping-term-ms = <300>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
        };

        // ホームの段の長押し: A Shift・D Control+Option（D を押さえて Space・Enter で Orca の会話の開始・送信など）、右は ' Shift。
        // 反対の手のキーと親指にだけ効く。
        // 速打ちで誤って働かないように: 文字を打った直後 0.15 秒以内は必ず文字、0.25 秒押さえたうえで反対の手のキー（と親指）を押したときだけ修飾キー
        lhs: left_home_shift {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <250>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <5 6 7 8 9 16 17 18 19 20 21 28 29 30 31 32 33 37 38 39 40 41 42>;
            hold-trigger-on-release;
        };

        rhs: right_home_shift {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <250>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 15 22 23 24 25 26 27 34 35 36 37 38 39 40 41 42>;
            hold-trigger-on-release;
        };

        // I の長押しでボールのスクロール（第 71 版で戻した。第 67〜70 版は Mac 操作の面）（第 55 版で Mac 操作の面からスクロールに戻した。N の長押しは第 49 版で外した）。「に」「の」のように N の直後に右手のキーを続けて打ったとき、
        // N が長押しと判定されて I・O が音量になっていたので、右手のキーが続いたら必ず文字の N にする。
        // 文字を打った直後 0.15 秒以内も必ず N。Mac 操作の面は N を押さえて左手のキーで使う
        nlt: n_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 15 22 23 24 25 26 27 34 35 36 37 38 39>;
            hold-trigger-on-release;
        };

        // 左親指の真ん中の Space: 長押しで Command。Command+C などを素早く打てるよう balanced にし、
        // 文字を打った直後 0.15 秒以内は必ず Space（速打ちで Command+文字 に化けないように）
        tmt: thumb_mod_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <220>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <150>;
            // 長く押しても他のキーを押さずに離したら Space として出す
            retro-tap;
        };

        // 左親指の真ん中の Space: 長押しで Mac 操作の面（第 53 版）。押し方の決め方は上の tmt と同じ
        tlt: thumb_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <220>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <150>;
            retro-tap;
        };

        // 左親指のいちばん外の Tab（第 71 版）: 長押しでボールのスクロール（面 6）。押さえてボールを動かし、何も打たずに離しても Tab は出さない（retro-tap なし）。
        // 軽押しのすぐ後の押し続けは Tab の連続
        tsc: tab_scroll {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
        };

        // 左親指のいちばん端（軽押し Tab・長押し Control）と中央寄り（軽押し 英かな・長押し Option）。
        // 修飾キーを素早く使えるよう balanced にする。軽押しのすぐ後の押し続けは前方削除の連続
        cmt: quick_mod_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
        };

        // 内側の列の 2 役キー（N の左隣: 軽押し 音声入力のモード切り替え ⌘/・長押し 音声入力 ⌘.）。第 46 版で軽押しを B から ⌘/ に（B は左手で打つ）。
        // 長押しは 0.3 秒としっかり長めに。文字を打った直後 0.15 秒以内は必ず軽押し
        vbs: slow_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "tap-preferred";
            tapping-term-ms = <300>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <150>;
        };

        // G の右隣（第 48 版で B の右隣から 1 つ上へ。空いた B の右隣は押さえている間ボールでスクロール）: 軽押し 取り消し（⌘Z）・長押し やり直し（⇧⌘Z）。第 43 版で専用に分けた。
        // 長押しが効かなかったので、長押しまでの時間を 0.3 秒から 0.2 秒に縮め、取り消しを続けて打った直後でもすぐ長押しと判定する（quick-tap を 0）。
        // 長押しのやり直しは 1 回だけ出す（押し続けても繰り返さない）
        urd: undo_redo {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&tap_once>, <&kp>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            require-prior-idle-ms = <150>;
        };

        // 長押しで面に入るキー（第 61 版）: 右親指の Enter で数字＋よく使う記号＋矢印、左の B で余った記号と F キー、右親指の delete（Backspace）で Mac 操作の面。
        // 長押しして何も打たずに離しても delete・Enter・B は出さない（文字を消さない・誤って送信しない）。文字を打った直後 0.15 秒以内は必ず軽押し
        // delete（第 75 版）: 軽押し delete・長押しでアプリ切替（押した瞬間 Command を押さえて Tab 1 回、離すと Command を離す）。
        // delete を押さえたまま左親指の Tab で次のアプリへ。前は G の右隣にあった &app_switch と同じ動き。後ろの数は使わない（0 を書く）
        dsw: delete_app_switch {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&app_switch_p>, <&kp>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <150>;
        };

        blt: right_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <150>;
        };
    };

    // 第 74 版: D と F をほぼ同時（0.05 秒以内）に押して離すと、次に押す 1 つだけ Alfred の面（&sl 8）。
    // 文字を打った直後 0.15 秒以内は同時押しとみなさない（ローマ字の速打ち対策）。ふだんの面と英かなの面でだけ効く
    combos {
        compatible = "zmk,combos";
        combo_alfred {
            timeout-ms = <50>;
            key-positions = <12 13>;
            bindings = <&sl 8>;
            require-prior-idle-ms = <150>;
            layers = <0 1>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&sct ESC Q        &sct LG(W) W     &kp E     &kp R              &kp T                                                                   &kp Y      &kp U          &nlt 6 I   &kp O    &kp P     
&sct LG(A) A      &ghm LG(LSHIFT) S         &lhs LC(LALT) D &sct LG(SPACE) F                  &ghm LC(LGUI) G                   &none                              &sct EXCLAMATION QUESTION     &kp H  &rhs LCTRL J  &rhs LALT K  &kp L  &rhs LSHIFT MINUS      
&kp Z             &sct LG(X) X        &sct LG(C) C        &sct LG(V) V                   &blt 3 B               &urd LS(LG(Z)) LG(Z)                      &vbs LG(PERIOD) LG(SLASH)           &kp N      &kp M  &kp COMMA  &kp DOT  &tap_once SLASH  
&mo 6             &kp LALT        &kp LCTRL          &tmt LSHIFT SPACE         &tmt LGUI TAB              &ekk 4 0            &dsw 0 BACKSPACE              &blt 2 ENTER                                              &lt 6 DELETE
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        // 英かなの切り替え用（第 61 版、面 1）: かなを送った後だけ入る。いちばん下に置く（上に置くとボールのドライバが「いちばん上の面」でスクロールを判定するので、かなの間スクロールが効かなくなった）。英かなの位置だけ「次は英数」、ほかはすべて下の面のまま
        EIKANA {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &eke 4 0         &trans  &trans                          &trans
            >;
        };

        // 第 75 版: 左手を Q *・W %・A -・S +・Z ÷・X ×・B の右隣 =、Z の真下 ,・X の真下 .・C の真下 0 に（G の右隣・Tab の位置は空き、A の Shift は外した。下の説明はそれ以前のもの）
        // 数字＋よく使う記号＋矢印の面（第 61 版。右親指の Enter の長押し）。左手は電卓の並び（F が 5、0 は左親指の Space の位置。送るのは上の段の普通の数字＝⌘1 などが確実に効く）。
        // 左: Q *・W +・S -・Z ,・X .・G の右隣 =・B の右隣 %、A は押さえている間 Shift（矢印で範囲を選ぶ）。
        // 左の下の段（Enter を押さえている間）: X の真下 ×・C の真下 ÷。Control+Option+Command+Shift+- と = を送り、BetterTouchTool が × ÷ の文字を入れる（第 61 版で登録）
        // 右: 上の段 & | ? ! :（第 74 版で ? ! & | から並べ替え）、H の左隣 #・H @、J ← K ↓ L ↑ ' →、下の段 N の左隣 "（# の下）・N _・M (（← の下）・, )（↓ の下）・. \・/ /
// \ は第 64 版から Control+Option+Command+Shift+\ を送り、BetterTouchTool が半角の \ を入れる（かなのままだと ¥ になっていたため）
// / は第 66 版から Control+Option+Command+Shift+; を送り（第 63 版の +/ は BetterTouchTool に届かなかった。ふだんの / は元のまま＝かなでは「・」）、BetterTouchTool が半角の / を入れる（かなのままだと / が「・」になっていたため）
        NUM_SYM {
            bindings = <
&kp ASTERISK &kp PERCENT &kp N7   &kp N8   &kp N9                                                    &kp AMPERSAND  &kp PIPE         &kp QUESTION    &kp EXCLAMATION  &kp COLON
&kp MINUS    &kp PLUS   &kp N4   &kp N5   &kp N6   &none                        &kp HASH            &kp AT_SIGN    &kp LEFT_ARROW   &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW
&kp LC(LA(LG(LS(EQUAL))))  &kp LC(LA(LG(LS(MINUS))))  &kp N1   &kp N2   &kp N3   &kp EQUAL                  &kp DOUBLE_QUOTES    &kp UNDERSCORE  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp LC(LA(LG(LS(BACKSLASH))))  &kp LC(LA(LG(LS(SEMICOLON))))
&kp COMMA    &kp DOT    &kp N0   &none    &trans   &trans                       &trans              &trans                                                                &trans
            >;
        };

        // 余った記号と F キーの面（第 61 版。左の B の長押し）。第 74 版: Alfred 用の文字マクロは F の長押しの Alfred の面へ移し、$ を H の左隣に戻した（U の長押しの $ は外した）。Enter の面にある記号（: _ \ " など）は置かない。
        // 左: F キーは Enter の面の数字と同じ場所（F が F5、E R T が F7 F8 F9、D G が F4 F6、C V が F1 F2）。B は押さえるので F3 は B の右隣。F10 は Space、F11 は Tab の位置、F12 は G の右隣（F6 の右）。右: 記号は間を空けずに詰める（上の段 ; ` ' ~ ^、H の左隣 $（第 67 版で H から移した）、下の段 { [ ] < > }＝第 68 版で < > と { } を入れ替え）。H J K L ' は第 67 版から文字 cw・bm・cal・fna・ls（Alfred 用）。第 69 版で H の左隣 fna・H cw・J bm・K cal・L ls・' td（ToDo 登録）に並べ替え、$ はふだんの面の U の長押しへ
        SYM_F {
            bindings = <
&none    &none    &kp F7   &kp F8   &kp F9                                                &none          &none             &none              &none             &none    
&none    &none    &kp F4   &kp F5   &kp F6   &kp F12                 &kp DOLLAR           &kp SEMICOLON  &kp GRAVE         &kp SINGLE_QUOTE   &kp TILDE         &kp CARET
&none    &none    &kp F1   &kp F2   &trans   &kp F3                  &kp LEFT_BRACE       &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LESS_THAN   &kp GREATER_THAN &kp RIGHT_BRACE
&trans   &trans   &trans   &kp F10  &kp F11  &trans                  &trans               &trans                                                                       &trans
            >;
        };

        // 第 75 版: 入口は左親指の Tab の長押しだけ（P・delete の長押しは外した。delete の長押しはアプリ切替、Tab の長押しのスクロールは外した）
        // Mac 操作・メディアの面（右の P・delete の長押し。Z の真下は第 73 版でスクロールに変えた）。右手は画面の操作と撮影、左手は音楽・アプリを開くキー・Bluetooth。
        // 第 76 版: BT 1（接続先 1 に戻す BT_SEL 0）を外し、右の下の段を左へ詰めた（N の左隣 最小化・N 窓を左半分・M 最大化・, 右半分）。Bluetooth の接続先を変えるキーは 1 つも無い
        // 第 74 版: 下の段の左 6 つ（最小化・BT 1・窓の左半分・最大化・右半分・空き）と右 6 つ（書式なしで貼る・撮影 4 つ・撮影メニュー）を並び順のまま入れ替えた（下の説明の左右はそれ以前のもの）
        // Bluetooth は X の接続先 1 だけ（第 42 版で接続先 2〜4 と接続を消すキーを外した。撮影のときに誤って押して接続先が切り替わったため）
        // 第 72 版: A Google カレンダー（Control+Option+Command+C）、Notion は E へ（Meet は外した）。
        // アプリを開くキー（E Notion・S Finder・D Orca（第 43 版で S と D を入れ替え）・F Google Chrome・G Chatwork・G の右隣 LINE）は Control+Option+Command+Shift+1〜6 を送る（Notion 1・Orca 2・Finder 3・LINE 4・Chatwork 5・Chrome 6）。開く設定は Mac 側（BetterTouchTool）で
        // 右手の中の段は外から 左のタブ・左のデスクトップ・Mission Control・右のデスクトップ・右のタブ（' の位置は空き）
        // 左の下の段はウィンドウ操作（第 45 版）: Z 最小化 Cmd+M、C 左半分・V 最大化・B 右半分は Control+Option+Command+Shift+8・9・0 を BetterTouchTool で（第 46 版で Rectangle から移した。C の Control+Option+← が届かなかったため）
        // 撮影の履歴は第 74 版から Control+Command+H（CleanShot のホットキー。G の長押し＋H で開くのを串田さんが確認。Hyper+7 の BetterTouchTool 経由は開かなかった）。撮影は CleanShot の設定に合わせる（第 52 版で読み直した: N 範囲 Control+Cmd+A、M 全画面 Control+Cmd+F、, 画面の文字 Control+Cmd+T、/ 撮影メニュー Control+Cmd+O）。. の CleanShot の履歴は Control+Option+Command+Shift+7 を BetterTouchTool で cleanshot://open-history に
        MAC_MEDIA {
            bindings = <
&none   &none         &kp LC(LA(LG(LS(N1))))  &kp LA(S)     &kp LG(H)                                         &kp C_BRI_DN       &kp C_BRI_UP        &kp C_VOL_DN      &kp C_VOL_UP         &kp C_MUTE
&kp LC(LA(LG(LS(C))))   &kp LC(LA(LG(LS(F))))   &kp LC(LA(LG(LS(N2))))  &kp LC(LA(LG(LS(N6))))  &kp LC(LA(LG(LS(N5))))  &kp LC(LA(LG(LS(N4))))  &kp LC(LS(TAB))    &kp LC(LEFT_ARROW) &kp LC(UP_ARROW)  &kp LC(RIGHT_ARROW)  &kp LC(TAB)  &none
&kp LA(LS(LG(V)))  &kp LC(LG(A))      &kp LC(LG(F))       &kp LC(LG(T))     &kp LC(LG(H))           &kp LC(LG(O))          &kp LG(M)  &kp LC(LA(LG(LS(N8))))  &kp LC(LA(LG(LS(N9))))  &kp LC(LA(LG(LS(N0))))  &none  &none 
&trans  &trans        &trans        &trans        &trans        &trans         &trans             &trans                                                                   &trans
            >;
        };

        // マウスの面（ボールを動かした後 1.5 秒）。J 左クリック（押さえている間ボールがゆっくり）・L 右クリック（第 39 版で K から L へ。K は文字のまま）
        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &slow_drag  &trans    &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                &trans
            >;
        };

        // スクロールの面（Z の真下（第 73 版で Mac 操作の面から変更）・Tab・I・右下の角を押さえている間。ボールでスクロール）。
        // 押さえている間は J 左クリック（押さえている間ボールがゆっくり）・L 右クリックが時間切れなしで使える。
        // マウスキー: 左手の E S D F でカーソルを ↑ ← ↓ →、R で上へ・V で下へスクロール（Mac のナチュラルなスクロールに合わせて SCRL_DOWN・SCRL_UP を逆に割り当て）。第 73 版: X で左へ・C で右へ（同じく SCRL_RIGHT・SCRL_LEFT を逆に。向きは実機で未確認）。U 左クリック、O 右クリック
        // 拡大・縮小（タッチパッドのピンチの代わり）: T 拡大 Command+=、G 縮小 Command+-、B 元の大きさ Command+0
        SCROLL {
            bindings = <
&trans  &trans          &mmv MOVE_UP    &msc SCRL_DOWN   &kp LG(EQUAL)               &trans  &mkp MB1  &trans    &mkp MB2  &trans
&trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &kp LG(MINUS)  &trans      &trans  &trans  &slow_drag  &trans    &mkp MB2  &trans
&trans  &msc SCRL_RIGHT  &msc SCRL_LEFT  &msc SCRL_UP     &kp LG(N0)     &trans      &trans  &trans  &trans    &trans    &trans    &trans
&trans  &trans          &trans          &trans           &trans  &trans      &trans  &trans                                &trans
            >;
        };

        // ドラッグ中の面（J の左クリックを押さえている間だけ。中身はすべて下の面のまま、ボールが半分の速さになる）
        SLOW_DRAG {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        // Alfred の面（第 74 版。D と F の同時押し（上の combos）、面 8）。B の長押しの面にあった Alfred 用の文字マクロを同じ場所のまま移した。
        // 左: Q sp・W spn・A dq・S dqn・Z gc、右: H の左隣 fna・H cw・J bm・K cal・L ls・' td。ほかのキーは下の面のまま。
        // いちばん上に置くが、同時押しの後の 1 キーの間だけなのでボールのスクロールの判定には響かない
        ALFRED {
            bindings = <
&str_sp  &str_spn &trans   &trans   &trans                                &trans   &trans   &trans   &trans   &trans
&str_dq  &str_dqn &trans   &trans   &trans   &trans          &str_fna     &str_cw  &str_bm  &str_cal &str_ls  &str_td
&str_gc  &trans   &trans   &trans   &trans   &trans          &trans       &trans   &trans   &trans   &trans   &trans
&trans   &trans   &trans   &trans   &trans   &trans          &trans       &trans                              &trans
            >;
        };
    };
};

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
// マウスキーは細かい位置合わせ用にゆっくり（初期値 600 の半分以下）
#define ZMK_POINTING_DEFAULT_MOVE_VAL 250
#define ZMK_POINTING_DEFAULT_SCRL_VAL 10
#include <dt-bindings/zmk/pointing.h>

// 面の番号: 0 ふだん / 1 数字と F キー / 2 記号と矢印 / 3 Mac 操作・メディア / 4 マウス / 5 スクロール
// 4 と 5 は &trackball の automouse-layer・scroll-layers が指しているので番号を変えない
// 親指は串田さんの呼び方に合わせる: 「外側」＝中央寄り（斜めに傾いたキー）。
// 左親指 中央寄りから Command（長押し 数字と F）・Space・Tab、右親指 中央寄りから delete（Backspace）・Enter
// スクロール: I の長押し、または右下の角（前方削除）の長押しをしながらボール
// 入り方: 1 左親指の中央寄りの長押し、または右親指の delete（Backspace）の長押し / 2 右親指の Enter の長押し / 3 Z の真下を押さえている間

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    automouse-layer = <4>;
    scroll-layers = <5>;
};

/ {
    macros {
        // 受け取ったキーを 1 回だけ打つ（長押しで ⌘C などを 1 回だけ出す。押し続けても繰り返さない）
        tap_once: tap_once {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&macro_param_1to1>, <&macro_tap &kp MACRO_PLACEHOLDER>;
        };
    };

    behaviors {
        // 左親指の中央寄り: 軽押しで Command（次に押したキーに Command が付く。押しっぱなしにしなくてよい）、長押しで数字と F キーの面
        ost: oneshot_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&sk>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
        };

        // 文字キーの長押しでよく使う操作（Q Esc、S ⌘S、Z ⌘Z、X ⌘X、C ⌘C、V ⌘V）。
        // 速打ちで誤って出ないよう、文字を打った直後 0.15 秒以内は必ず文字、長押しは 0.3 秒
        sct: shortcut_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&tap_once>, <&kp>;
            flavor = "tap-preferred";
            tapping-term-ms = <300>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
        };

        // ホームの段の長押しで修飾キーの束。規則: 左は Control、右は Command が土台。中指で Shift、人差し指で Option、
        // 人差し指の内側（G・H）で Control と Command の両方を足す。G の右隣は Control+Option+Command の 3 つ全部（軽押しは Mission Control）。
        // 左: D Control+Shift・F Control+Option（F+Space で Orca）・G Control+Command。右: K Command+Shift（K+T で画面の文字の撮影）・J Command+Option・H Command+Control
        // 小指は Shift（A と '）。反対の手のキーと親指にだけ効く。
        // 速打ちで誤って働かないように: 文字を打った直後 0.15 秒以内は必ず文字、0.25 秒押さえたうえで反対の手のキー（と親指）を押したときだけ修飾キー
        lhs: left_home_shift {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <250>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <5 6 7 8 9 16 17 18 19 20 21 28 29 30 31 32 33 37 38 39 40 41 42>;
            hold-trigger-on-release;
        };

        rhs: right_home_shift {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <250>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 15 22 23 24 25 26 27 34 35 36 37 38 39 40 41 42>;
            hold-trigger-on-release;
        };

        // 左親指の真ん中の Space: しっかり長く押したときだけ Option にする
        tmt: thumb_mod_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "tap-preferred";
            tapping-term-ms = <220>;
            quick-tap-ms = <150>;
            // 長く押しても他のキーを押さずに離したら Space として出す
            retro-tap;
        };

        // 左親指のいちばん端（軽押し Tab・長押し Control）。
        // Command+C などを素早く打てるよう balanced にする。軽押しのすぐ後の押し続けは前方削除の連続
        cmt: quick_mod_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
        };

        // 内側の列の 2 役キー（N の左隣: 軽押し B・長押し 音声入力、B の右隣: 軽押し 取り消し・長押し やり直し）。
        // 長押しは 0.3 秒としっかり長めに。文字を打った直後 0.15 秒以内は必ず軽押し
        vbs: slow_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "tap-preferred";
            tapping-term-ms = <300>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <150>;
        };

        // 右親指の面の切り替え: delete（Backspace）の長押しで数字と F キーの面、Enter の長押しで記号と矢印の面。
        // 長押しして何も打たずに離しても delete・Enter は出さない（文字を消さない・誤って送信しない）
        blt: right_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <150>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&sct ESC Q        &kp W     &kp E     &kp R              &kp T                                                                   &kp Y      &kp U  &lt 5 I    &kp O    &kp P
&lhs LSHIFT A     &sct LG(S) S &lhs LC(LSHIFT) D &lhs LC(LALT) F            &lhs LC(LGUI) G                   &lhs LC(LA(LGUI)) LC(UP_ARROW)    &kp MINUS                     &rhs LG(LCTRL) H  &rhs LG(LALT) J  &rhs LG(LSHIFT) K  &kp L  &rhs LSHIFT SQT
&sct LG(Z) Z      &sct LG(X) X &sct LG(C) C &sct LG(V) V            &kp B               &vbs LS(LG(Z)) LG(Z)  &vbs LG(PERIOD) B            &kp N      &kp M  &kp COMMA  &kp DOT  &kp SLASH
&mo 3             &none       &kp LC(SPACE)  &cmt LCTRL TAB       &tmt LALT SPACE  &ost 1 LGUI          &blt 1 BACKSPACE          &blt 2 ENTER                                        &lt 5 DELETE
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        // 数字と F キーの面（左親指の中央寄りか、右親指の delete の長押し）。左手に F キー、右手にテンキーの並び
        NUM_F {
            bindings = <
&kp F1   &kp F2   &kp F3   &kp F4   &none                                                 &kp MINUS        &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp PLUS
&kp F5   &kp F6   &kp F7   &kp F8   &none    &none                       &none            &kp SLASH        &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp ASTERISK
&kp F9   &kp F10  &kp F11  &kp F12  &none    &none                       &kp EQUAL        &kp KP_NUMBER_0  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp PERIOD
&trans   &trans   &trans   &trans   &trans   &trans                      &trans           &trans                                                              &trans
            >;
        };

        // 記号と矢印の面（右親指の Enter の長押し）。Y の位置は ;（動画の図では /。/ はふだんの面にある）。動画の配列図の Layer 2 の並び（^ と _ は人差し指の内側、Home・End は下の段の内側）
        SYMBOL {
            bindings = <
&kp QUESTION  &kp EXCLAMATION   &kp AMPERSAND      &kp PIPE          &kp BACKSLASH                                                  &kp SEMICOLON          &kp EQUAL          &kp ASTERISK      &kp PLUS          &kp PERCENT
&kp HASH      &kp GRAVE         &kp DOUBLE_QUOTES  &kp SINGLE_QUOTE  &kp TILDE             &kp CARET      &kp UNDERSCORE           &kp LEFT_ARROW         &kp DOWN_ARROW     &kp UP_ARROW      &kp RIGHT_ARROW   &kp COLON
&kp AT_SIGN   &kp LESS_THAN     &kp LEFT_BRACE     &kp LEFT_BRACKET  &kp LEFT_PARENTHESIS  &kp HOME       &kp END                  &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACKET  &kp RIGHT_BRACE   &kp GREATER_THAN  &kp DOLLAR
&trans        &trans            &trans             &trans            &kp DELETE            &trans         &trans                   &trans                                                                           &trans
            >;
        };

        // Mac 操作・メディアの面（Z の真下を押さえている間）。右手は画面の操作と撮影、左手は音楽・アプリを開くキー・Bluetooth。
        // アプリを開くキー（A Notion・S Chatwork・D Orca・F Finder・G LINE）は Control+Option+Command+Shift+1〜5 を送る（Notion 1・Orca 2・Finder 3・LINE 4・Chatwork 5）。開く設定は Mac 側で
        // 撮影は CleanShot の設定に合わせる（全画面 Shift+Cmd+3、範囲 4、まとめ 0、画面の文字 T）
        MAC_MEDIA {
            bindings = <
&none   &kp C_PREV    &kp C_PP      &kp C_NEXT    &kp LG(SLASH)                                     &kp C_BRI_DN       &kp C_BRI_UP        &kp C_VOL_DN      &kp C_VOL_UP         &kp C_MUTE
&kp LC(LA(LG(LS(N1))))  &kp LC(LA(LG(LS(N5))))  &kp LC(LA(LG(LS(N2))))  &kp LC(LA(LG(LS(N3))))  &kp LC(LA(LG(LS(N4))))  &none  &kp LC(LS(TAB))    &kp LC(LEFT_ARROW) &kp LC(DOWN_ARROW)  &kp LC(UP_ARROW)  &kp LC(RIGHT_ARROW)  &kp LC(TAB)
&none   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_CLR     &kp LA(LS(LG(V)))  &kp LS(LG(N3))     &kp LS(LG(N4))      &kp LS(LG(N0))    &kp LS(LG(T))        &bootloader
&trans  &trans        &trans        &trans        &trans        &trans         &trans             &trans                                                                   &trans
            >;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                &trans
            >;
        };

        // スクロールの面（I か右下の角を押さえている間。ボールでスクロール）。
        // マウスキー（細かい位置合わせ用）: 右下の角を押さえたまま H J K L でカーソルを少しずつ ← ↓ ↑ →（矢印の面と同じ向き）、U 左クリック、O 右クリック
        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans          &mkp MB1        &trans        &mkp MB2         &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans          &trans          &trans        &trans           &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                                         &trans
            >;
        };

    };
};

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
// マウスキーの速さ（初期値 600 より少しゆっくり。細かい位置合わせは J を押さえてボール）
#define ZMK_POINTING_DEFAULT_MOVE_VAL 450
#define ZMK_POINTING_DEFAULT_SCRL_VAL 10
#include <dt-bindings/zmk/pointing.h>

// 面の番号（第 61 版で付け直し）: 0 ふだん / 1 英かなの切り替え用（かなを送った後） / 2 数字＋よく使う記号＋矢印 / 3 余った記号と F キー / 4 Mac 操作・メディア / 5 マウス / 6 スクロール / 7 ドラッグ中（ボールをゆっくり）
// 5・6・7 は &trackball の automouse-layer・scroll-layers・snipe-layers が指している（ドライバはいちばん上の面で判定する）
// 親指は串田さんの呼び方に合わせる: 「外側」＝中央寄り（斜めに傾いたキー）。
// 左親指 中央寄りから 英かな（Control+Space。第 49 版で長押しの Option を外した）・Space（長押し Command）・Tab（長押し Control）。左の下の段 B の右隣 Shift（第 50 版）・X の真下 Option・C の真下 Command（押さえている間。第 49 版）。右親指 中央寄りから delete（Backspace）・Enter（第 49 版で入れ替え。長押しはキーと一緒に動かした）
// スクロール: / の長押し・左親指の英かなの長押し（第 50 版で B の右隣から移した。B の右隣は Shift に。A と ' の長押しの Shift は外した）（I は Mac 操作の面へ、N は第 49 版で長押し無し）（使いやすいのを試す）、または右下の角（前方削除）の長押しをしながらボール
// 第 52 版: X の真下 Option・C の真下 Control（第 55 版で入れ替え）・左親指は外から Space（長押し Command）・Tab（長押し Mac 操作の面）（第 54 版で軽押しの Space と Tab を入れ替え。長押しは場所のまま）・S の長押し Command+Shift。B と / の長押しは外した（第 51 版）
// 第 56 版: J の長押し Control・K の長押し Option（右手の 2 役は左手か親指のキーと一緒のときだけ長押しになる＝rhs）
// 第 57 版: 左親指の Tab の長押しを Shift、B の右隣を押さえている間 Mac 操作の面（前は Shift）、右親指の Enter と delete を長押しごと元に戻す（中央寄り Enter＝記号と矢印、隣 delete＝数字と F）
// 第 58 版: B の長押しで Mac 操作の面、取り消し・やり直しを G の右隣から B の右隣へ（G の右隣は空き）
// 第 60 版: G の右隣にアプリ切替（押している間 Command を押さえて Tab を 1 回。押したまま左親指の Tab で次へ・ボールで合わせて選ぶ、離すと切り替わる。軽押しは直前のアプリへ）
// 第 61 版: 面の組み替え。1 Enter の長押し＝数字（左手に電卓の並び、F が 5、0 は Space の位置）＋よく使う記号＋矢印 / 2 B の長押し＝余った記号と F1〜F12 / 3 delete の長押し＝Mac 操作の面（Z の真下・' の長押しからも）。Home・End は外した。
// 第 61 版: 英かなは押すたびに かな（LANG1）と 英数（LANG2）を交互に送る（前は Control+Space＝前の入力ソース。続けて押すと全角英字などへ飛んだ）。どちらを送ったかはキーボードが覚える（面 1 の入・切）。ずれたら 1 回余分に押せば合う
// 入り方: 1 右親指の Enter の長押し / 2 左の B の長押し / 3 右親指の delete の長押し、Z の真下を押さえている間、右の ' の長押し / 7 かなを送った後（英かなの次の 1 回を英数にするだけ）

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    automouse-layer = <5>;
    scroll-layers = <6>;
    snipe-layers = <7>;
};

/ {
    macros {
        // 受け取ったキーを 1 回だけ打つ（長押しで ⌘C などを 1 回だけ出す。押し続けても繰り返さない）
        tap_once: tap_once {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&macro_param_1to1>, <&macro_tap &kp MACRO_PLACEHOLDER>;
        };

        // 左クリックを押さえている間だけドラッグ中の面（6）に入り、ボールをゆっくりにする（選ぶ範囲の微調整用）
        slow_drag: slow_drag {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings
                = <&macro_press &mo 7 &mkp MB1>
                , <&macro_pause_for_release>
                , <&macro_release &mkp MB1 &mo 7>
                ;
        };

        // 英かな（第 61 版）: かな（LANG1）を送って面 1 を入れる → 次の 1 回は英数（LANG2）を送って面 1 を切る。受け取る数は使わない
        to_kana: to_kana {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&macro_tap &kp LANG1 &tog 1>;
        };

        to_eisu: to_eisu {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&macro_tap &kp LANG2 &tog 1>;
        };

        // アプリ切替（第 60 版、G の右隣）: 押した瞬間に Command を押さえて Tab を 1 回 → アプリのアイコンが並ぶ。
        // 押している間は Command を押さえたまま（左親指の Tab で次のアプリ、Tab の長押し Shift と一緒に Tab で前へ、ボールでアイコンに合わせても選べる）。
        // 離すと Command も離れて、選んだアプリに切り替わる。軽く押すだけなら直前のアプリへ。
        // 第 31 版の tri-state（&kt で Command を押しっぱなしにする作り）は Command が押されたまま残ったので使わない。押す・離すがキーの押す・離すと必ず対になる作り
        app_switch: app_switch {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <30>;
            bindings
                = <&macro_press &kp LGUI>
                , <&macro_tap &kp TAB>
                , <&macro_pause_for_release>
                , <&macro_release &kp LGUI>
                ;
        };
    };

    behaviors {
        // 英かな（第 61 版、左親指の中央寄り）: 軽押しは かな と 英数 を交互に、長押しはボールでスクロール（前の &lt 6 と同じ）
        ekk: eikana_kana {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&to_kana>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
        };

        eke: eikana_eisu {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&to_eisu>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
        };

        // G（長押し Control+Command）。G の右隣の長押し Command+Shift は第 48 版で外した（G の右隣は取り消し・やり直しに。CleanShot の文字の写し取りは Mac 操作の面の , ）。
        // G の右隣の軽押しは Mission Control だったが、誤って押しやすいので第 39 版で外した（Mission Control は Mac 操作の面の J の位置にある）
        // G+T のように同じ左手のキーとも組めるよう、手の左右を問わない。0.25 秒押さえたときだけ長押し、打った直後 0.15 秒以内は必ず軽押し
        ghm: g_hold_mod {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "tap-preferred";
            tapping-term-ms = <250>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
        };

        // 軽押しは何も出さない（&none）、長押しだけ働く 2 役キー。第 48 版から使っている所は無い
        ghn: g_hold_only {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&none>;
            flavor = "tap-preferred";
            tapping-term-ms = <250>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
        };

        // 文字キーの長押しでよく使う操作（Q Esc、F Alfred＝Command+Space、第 61 版で W ⌘W・X ⌘X・C ⌘C・V ⌘V を戻した）。S・X・C・V の長押し（⌘S・⌘X・⌘C・⌘V）は分かりにくいので第 43 版で外した。
        // 速打ちで誤って出ないよう、文字を打った直後 0.15 秒以内は必ず文字、長押しは 0.3 秒
        sct: shortcut_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&tap_once>, <&kp>;
            flavor = "tap-preferred";
            tapping-term-ms = <300>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
        };

        // ホームの段の長押し: A Shift・D Control+Option（D を押さえて Space・Enter で Orca の会話の開始・送信など）、右は ' Shift。
        // 反対の手のキーと親指にだけ効く。
        // 速打ちで誤って働かないように: 文字を打った直後 0.15 秒以内は必ず文字、0.25 秒押さえたうえで反対の手のキー（と親指）を押したときだけ修飾キー
        lhs: left_home_shift {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <250>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <5 6 7 8 9 16 17 18 19 20 21 28 29 30 31 32 33 37 38 39 40 41 42>;
            hold-trigger-on-release;
        };

        rhs: right_home_shift {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <250>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 15 22 23 24 25 26 27 34 35 36 37 38 39 40 41 42>;
            hold-trigger-on-release;
        };

        // I の長押しでボールのスクロール（第 55 版で Mac 操作の面からスクロールに戻した。N の長押しは第 49 版で外した）。「に」「の」のように N の直後に右手のキーを続けて打ったとき、
        // N が長押しと判定されて I・O が音量になっていたので、右手のキーが続いたら必ず文字の N にする。
        // 文字を打った直後 0.15 秒以内も必ず N。Mac 操作の面は N を押さえて左手のキーで使う
        nlt: n_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 15 22 23 24 25 26 27 34 35 36 37 38 39>;
            hold-trigger-on-release;
        };

        // 左親指の真ん中の Space: 長押しで Command。Command+C などを素早く打てるよう balanced にし、
        // 文字を打った直後 0.15 秒以内は必ず Space（速打ちで Command+文字 に化けないように）
        tmt: thumb_mod_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <220>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <150>;
            // 長く押しても他のキーを押さずに離したら Space として出す
            retro-tap;
        };

        // 左親指の真ん中の Space: 長押しで Mac 操作の面（第 53 版）。押し方の決め方は上の tmt と同じ
        tlt: thumb_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <220>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <150>;
            retro-tap;
        };

        // 左親指のいちばん端（軽押し Tab・長押し Control）と中央寄り（軽押し 英かな・長押し Option）。
        // 修飾キーを素早く使えるよう balanced にする。軽押しのすぐ後の押し続けは前方削除の連続
        cmt: quick_mod_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
        };

        // 内側の列の 2 役キー（N の左隣: 軽押し 音声入力のモード切り替え ⌘/・長押し 音声入力 ⌘.）。第 46 版で軽押しを B から ⌘/ に（B は左手で打つ）。
        // 長押しは 0.3 秒としっかり長めに。文字を打った直後 0.15 秒以内は必ず軽押し
        vbs: slow_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "tap-preferred";
            tapping-term-ms = <300>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <150>;
        };

        // G の右隣（第 48 版で B の右隣から 1 つ上へ。空いた B の右隣は押さえている間ボールでスクロール）: 軽押し 取り消し（⌘Z）・長押し やり直し（⇧⌘Z）。第 43 版で専用に分けた。
        // 長押しが効かなかったので、長押しまでの時間を 0.3 秒から 0.2 秒に縮め、取り消しを続けて打った直後でもすぐ長押しと判定する（quick-tap を 0）。
        // 長押しのやり直しは 1 回だけ出す（押し続けても繰り返さない）
        urd: undo_redo {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&tap_once>, <&kp>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            require-prior-idle-ms = <150>;
        };

        // 長押しで面に入るキー（第 61 版）: 右親指の Enter で数字＋よく使う記号＋矢印、左の B で余った記号と F キー、右親指の delete（Backspace）で Mac 操作の面。
        // 長押しして何も打たずに離しても delete・Enter・B は出さない（文字を消さない・誤って送信しない）。文字を打った直後 0.15 秒以内は必ず軽押し
        blt: right_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <150>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&sct ESC Q        &sct LG(W) W     &kp E     &kp R              &kp T                                                                   &kp Y      &kp U  &nlt 6 I   &kp O    &kp P  
&kp A             &ghm LG(LSHIFT) S         &lhs LC(LALT) D &sct LG(SPACE) F                  &ghm LC(LGUI) G                   &app_switch                        &kp MINUS                     &kp H  &rhs LCTRL J  &rhs LALT K  &kp L  &lt 4 SQT      
&kp Z             &sct LG(X) X        &sct LG(C) C        &sct LG(V) V                   &blt 3 B               &urd LS(LG(Z)) LG(Z)                      &vbs LG(PERIOD) LG(SLASH)           &kp N      &kp M  &kp COMMA  &kp DOT  &kp SLASH  
&mo 4             &kp LALT        &kp LCTRL          &tmt LGUI SPACE           &cmt LSHIFT TAB          &ekk 6 0       &blt 4 BACKSPACE              &blt 2 ENTER                                              &lt 6 DELETE
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        // 英かなの切り替え用（第 61 版、面 1）: かなを送った後だけ入る。いちばん下に置く（上に置くとボールのドライバが「いちばん上の面」でスクロールを判定するので、かなの間スクロールが効かなくなった）。英かなの位置だけ「次は英数」、ほかはすべて下の面のまま
        EIKANA {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &eke 6 0    &trans  &trans                          &trans
            >;
        };

        // 数字＋よく使う記号＋矢印の面（第 61 版。右親指の Enter の長押し）。左手は電卓の並び（F が 5、0 は左親指の Space の位置。送るのは上の段の普通の数字＝⌘1 などが確実に効く）。
        // 左: Q *・W +・S -・Z ,・X .・G の右隣 =・B の右隣 %、A は押さえている間 Shift（矢印で範囲を選ぶ）。
        // 左の下の段（Enter を押さえている間）: X の真下 ×・C の真下 ÷。Control+Option+Command+Shift+- と = を送り、BetterTouchTool が × ÷ の文字を入れる（第 61 版で登録）
        // 右: 上の段 ? ! & | :、H の左隣 #・H @、J ← K ↓ L ↑ ' →、下の段 N の左隣 "（# の下）・N _・M (（← の下）・, )（↓ の下）・. \・/ /
        NUM_SYM {
            bindings = <
&kp ASTERISK &kp PLUS   &kp N7   &kp N8   &kp N9                                                    &kp QUESTION   &kp EXCLAMATION  &kp AMPERSAND   &kp PIPE      &kp COLON
&kp LSHIFT   &kp MINUS  &kp N4   &kp N5   &kp N6   &kp EQUAL                    &kp HASH            &kp AT_SIGN    &kp LEFT_ARROW   &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW
&kp COMMA    &kp DOT    &kp N1   &kp N2   &kp N3   &kp PERCENT                  &kp DOUBLE_QUOTES    &kp UNDERSCORE  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp BACKSLASH  &kp SLASH
&trans       &kp LC(LA(LG(LS(MINUS))))     &kp LC(LA(LG(LS(EQUAL))))   &kp N0   &trans   &trans                       &trans              &trans                                                                &trans
            >;
        };

        // 余った記号と F キーの面（第 61 版。左の B の長押し）。Enter の面にある記号（: _ \ " など）は置かない。
        // 左: F キーは Enter の面の数字と同じ場所（F が F5、E R T が F7 F8 F9、D G が F4 F6、C V が F1 F2）。B は押さえるので F3 は B の右隣。F10 は Space、F11 は Tab の位置、F12 は G の右隣（F6 の右）。右: 記号は間を空けずに詰める（上の段 ; ` ' ~ ^、H $、下の段 < [ ] { } >）
        SYM_F {
            bindings = <
&none    &none    &kp F7   &kp F8   &kp F9                                                &kp SEMICOLON  &kp GRAVE         &kp SINGLE_QUOTE   &kp TILDE         &kp CARET
&none    &none    &kp F4   &kp F5   &kp F6   &kp F12                 &none                &kp DOLLAR     &none             &none              &none             &none
&none    &none    &kp F1   &kp F2   &trans   &kp F3                  &kp LESS_THAN        &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp GREATER_THAN
&trans   &trans   &trans   &kp F10  &kp F11  &trans                  &trans               &trans                                                                       &trans
            >;
        };

        // Mac 操作・メディアの面（Z の真下を押さえている間か、左の B・右の I・' の長押し）。右手は画面の操作と撮影、左手は音楽・アプリを開くキー・Bluetooth。
        // Bluetooth は X の接続先 1 だけ（第 42 版で接続先 2〜4 と接続を消すキーを外した。撮影のときに誤って押して接続先が切り替わったため）
        // アプリを開くキー（A Notion・S Finder・D Orca（第 43 版で S と D を入れ替え）・F Google Chrome・G Chatwork・G の右隣 LINE）は Control+Option+Command+Shift+1〜6 を送る（Notion 1・Orca 2・Finder 3・LINE 4・Chatwork 5・Chrome 6）。開く設定は Mac 側（BetterTouchTool）で
        // 右手の中の段は外から 左のタブ・左のデスクトップ・Mission Control・右のデスクトップ・右のタブ（' の位置は空き）
        // 左の下の段はウィンドウ操作（第 45 版）: Z 最小化 Cmd+M、C 左半分・V 最大化・B 右半分は Control+Option+Command+Shift+8・9・0 を BetterTouchTool で（第 46 版で Rectangle から移した。C の Control+Option+← が届かなかったため）
        // 撮影は CleanShot の設定に合わせる（第 52 版で読み直した: N 範囲 Control+Cmd+A、M 全画面 Control+Cmd+F、, 画面の文字 Control+Cmd+T、/ 撮影メニュー Control+Cmd+O）。. の CleanShot の履歴は Control+Option+Command+Shift+7 を BetterTouchTool で cleanshot://open-history に
        MAC_MEDIA {
            bindings = <
&none   &none         &none         &none         &none                                             &kp C_BRI_DN       &kp C_BRI_UP        &kp C_VOL_DN      &kp C_VOL_UP         &kp C_MUTE
&kp LC(LA(LG(LS(N1))))  &kp LC(LA(LG(LS(N3))))  &kp LC(LA(LG(LS(N2))))  &kp LC(LA(LG(LS(N6))))  &kp LC(LA(LG(LS(N5))))  &kp LC(LA(LG(LS(N4))))  &kp LC(LS(TAB))    &kp LC(LEFT_ARROW) &kp LC(UP_ARROW)  &kp LC(RIGHT_ARROW)  &kp LC(TAB)  &none
&kp LG(M)  &bt BT_SEL 0  &kp LC(LA(LG(LS(N8))))  &kp LC(LA(LG(LS(N9))))  &kp LC(LA(LG(LS(N0))))  &none          &kp LA(LS(LG(V)))  &kp LC(LG(A))      &kp LC(LG(F))       &kp LC(LG(T))     &kp LC(LA(LG(LS(N7))))  &kp LC(LG(O)) 
&trans  &trans        &trans        &trans        &trans        &trans         &trans             &trans                                                                   &trans
            >;
        };

        // マウスの面（ボールを動かした後 1.5 秒）。J 左クリック（押さえている間ボールがゆっくり）・L 右クリック（第 39 版で K から L へ。K は文字のまま）
        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &slow_drag  &trans    &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                &trans
            >;
        };

        // スクロールの面（I・N・/ か右下の角を押さえている間。ボールでスクロール）。
        // 押さえている間は J 左クリック（押さえている間ボールがゆっくり）・L 右クリックが時間切れなしで使える。
        // マウスキー: 左手の E S D F でカーソルを ↑ ← ↓ →、R で上へ・V で下へスクロール（Mac のナチュラルなスクロールに合わせて SCRL_DOWN・SCRL_UP を逆に割り当て）。U 左クリック、O 右クリック
        // 拡大・縮小（タッチパッドのピンチの代わり）: T 拡大 Command+=、G 縮小 Command+-、B 元の大きさ Command+0
        SCROLL {
            bindings = <
&trans  &trans          &mmv MOVE_UP    &msc SCRL_DOWN   &kp LG(EQUAL)               &trans  &mkp MB1  &trans    &mkp MB2  &trans
&trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &kp LG(MINUS)  &trans      &trans  &trans  &slow_drag  &trans    &mkp MB2  &trans
&trans  &trans          &trans          &msc SCRL_UP     &kp LG(N0)     &trans      &trans  &trans  &trans    &trans    &trans    &trans
&trans  &trans          &trans          &trans           &trans  &trans      &trans  &trans                                &trans
            >;
        };

        // ドラッグ中の面（J の左クリックを押さえている間だけ。中身はすべて下の面のまま、ボールが半分の速さになる）
        SLOW_DRAG {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };


    };
};

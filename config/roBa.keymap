#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

// 面の番号: 0 ふだん / 1 数字と F キー / 2 矢印 / 3 Mac 操作・メディア / 4 マウス / 5 スクロール / 6 記号
// 入り方（どれも 1 つのキーの長押し）: 1 左親指の Space / 2 左親指の英かな / 6 右親指の外側の Backspace
//   3 Z の真下（Mac の fn キーと同じ場所。左の小指の列は使わない）
// 4 と 5 は &trackball の automouse-layer・scroll-layers が指しているので番号を変えない

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    automouse-layer = <4>;
    scroll-layers = <5>;
};

/ {
    behaviors {
        // C の真下の Esc: しっかり長く押したときだけ Option にする
        tmt: thumb_mod_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "tap-preferred";
            tapping-term-ms = <220>;
            quick-tap-ms = <150>;
            // 長く押しても他のキーを押さずに離したら Esc として出す
            retro-tap;
        };

        // 左親指の面の切り替え（Space・英かな）: しっかり長く押したときだけ面にする。
        // 文字を打った直後 0.15 秒以内は必ず軽押し（速く打っているときに面へ入らない）
        slt: thumb_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <150>;
            retro-tap;
        };

        // 左親指の外側（軽押し Tab・長押し Command）と X の真下（軽押し Tab・長押し Control）。
        // Command+C・Control+C などを素早く打てるよう balanced にする
        cmt: quick_mod_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
        };

        // 右親指の内側の Enter: 長押しで音声入力（KoeType の Command+.）。確定のつもりの Enter が音声入力にならないよう長めに 0.3 秒。軽押しのすぐ後の押し続けは Enter の連続
        vbs: voice_enter {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "tap-preferred";
            tapping-term-ms = <300>;
            quick-tap-ms = <200>;
        };

        // 右親指の外側の Backspace: 長押しで記号の面。
        // 長押しして何も打たずに離しても Backspace は出さない（文字が消えないように retro-tap なし）
        blt: backspace_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <150>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q             &kp W     &kp E     &kp R              &kp T                                                                   &kp Y      &kp U  &lt 5 I    &kp O    &kp P
&kp A             &kp S     &kp D     &kp F              &kp G               &kp LEFT_BRACKET      &kp MINUS                     &kp H      &kp J  &kp K      &kp L    &kp SQT
&mt LEFT_SHIFT Z  &kp X     &kp C     &kp V              &kp B               &kp COLON             &kp SEMICOLON                 &kp N      &kp M  &kp COMMA  &kp DOT  &mt LEFT_SHIFT SLASH
&mo 3             &cmt LCTRL TAB &tmt LALT ESC &cmt LGUI TAB &slt 1 SPACE   &slt 2 LC(SPACE)      &vbs LG(PERIOD) ENTER         &blt 6 BACKSPACE                              &kp DELETE
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        // 数字と F キーの面（左親指の Space の長押し）。数字は右手、F キーは左手
        NUM_F {
            bindings = <
&kp F1   &kp F2   &kp F3   &kp F4   &none                                                &kp MINUS      &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp PLUS
&kp F5   &kp F6   &kp F7   &kp F8   &none    &none                       &none           &kp SLASH      &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp ASTERISK
&kp F9   &kp F10  &kp F11  &kp F12  &none    &none                       &kp EQUAL       &kp KP_NUMBER_0  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp PERIOD
&trans   &trans   &trans   &trans   &trans   &trans                      &trans          &trans                                                              &trans
            >;
        };

        // 矢印の面（左親指の英かなの長押し）。矢印は右手、左手のホームの段は修飾キー（A Control・S Option・D Command・F Shift）
        ARROW {
            bindings = <
&none      &none     &none     &none       &none                                     &none      &kp HOME       &kp PG_UP      &kp PG_DN      &kp END
&kp LCTRL  &kp LALT  &kp LGUI  &kp LSHIFT  &none     &none            &none          &kp LEFT   &kp DOWN       &kp UP         &kp RIGHT      &none
&none      &none     &none     &none       &none     &none            &none          &kp DELETE &none          &none          &none          &none
&trans     &trans    &trans    &trans      &trans    &trans           &trans         &trans                                                   &trans
            >;
        };

        // Mac 操作・メディアの面（Z の真下を押さえている間）。押さえている左小指の列（Q・A・Z）は空ける
        MAC_MEDIA {
            bindings = <
&none   &kp C_BRI_DN       &kp C_BRI_UP   &kp C_VOL_DN    &kp C_VOL_UP                                      &none               &kp C_PREV          &kp C_PP          &kp C_NEXT           &kp LG(SLASH)
&none   &kp C_MUTE         &kp LA(LS(LG(V))) &kp LS(LG(T)) &kp LC(LG(H))  &none         &kp LC(LS(TAB))  &kp LC(LEFT_ARROW)  &kp LC(DOWN_ARROW)  &kp LC(UP_ARROW)  &kp LC(RIGHT_ARROW)  &kp LC(TAB)
&trans  &bt BT_SEL 0       &bt BT_SEL 1   &bt BT_SEL 2    &bt BT_SEL 3   &bt BT_CLR    &none            &kp LS(LG(N3))      &kp LS(LG(N4))      &kp LS(LG(N0))    &none                &bootloader
&trans  &trans             &trans         &trans          &trans         &trans        &trans           &trans                                                                         &trans
            >;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        // 記号の面（右親指の外側の Backspace の長押し）。動画の配列図の Layer 2 の並び（^ と _ は人差し指の内側、Home・End は下の段の内側）
        SYMBOL {
            bindings = <
&kp QUESTION  &kp EXCLAMATION   &kp AMPERSAND      &kp PIPE          &kp BACKSLASH                                                  &kp SLASH              &kp EQUAL          &kp ASTERISK      &kp PLUS          &kp PERCENT
&kp HASH      &kp GRAVE         &kp DOUBLE_QUOTES  &kp SINGLE_QUOTE  &kp TILDE             &kp CARET      &kp UNDERSCORE           &kp LEFT_ARROW         &kp DOWN_ARROW     &kp UP_ARROW      &kp RIGHT_ARROW   &kp COLON
&kp AT_SIGN   &kp LESS_THAN     &kp LEFT_BRACE     &kp LEFT_BRACKET  &kp LEFT_PARENTHESIS  &kp HOME       &kp END                  &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACKET  &kp RIGHT_BRACE   &kp GREATER_THAN  &kp DOLLAR
&trans        &trans            &trans             &trans            &kp DELETE            &trans         &trans                   &trans                                                                           &trans
            >;
        };
    };
};

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

// 面の番号: 0 ふだん / 1 数字と F キー / 2 記号と矢印 / 3 Mac 操作・メディア / 4 マウス / 5 スクロール
// 4 と 5 は &trackball の automouse-layer・scroll-layers が指しているので番号を変えない
// 親指は串田さんの呼び方に合わせる: 「外側」＝中央寄り（斜めに傾いたキー）。
// 左親指 中央寄りから delete（Backspace）・Space・Tab、右親指 中央寄りから前方削除（Delete）・Enter
// 入り方: 1 X の真下（Esc）の長押し / 2 右親指の中央寄り（前方削除）の長押し / 3 Z の真下を押さえている間

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    automouse-layer = <4>;
    scroll-layers = <5>;
};

/ {
    behaviors {
        // 左親指の真ん中の Space: しっかり長く押したときだけ Option にする
        tmt: thumb_mod_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "tap-preferred";
            tapping-term-ms = <220>;
            quick-tap-ms = <150>;
            // 長く押しても他のキーを押さずに離したら Space として出す
            retro-tap;
        };

        // X の真下の Esc: しっかり長く押したときだけ数字と F キーの面にする。
        // 文字を打った直後 0.15 秒以内は必ず Esc（速く打っているときに面へ入らない）
        slt: esc_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <150>;
            // 長めに押しても他のキーを押さずに離したら Esc として出す
            retro-tap;
        };

        // 左親指の中央寄り（軽押し Backspace・長押し Control）といちばん端（軽押し Tab・長押し Command）。
        // Command+C などを素早く打てるよう balanced にする。軽押しのすぐ後の押し続けは Backspace の連続
        cmt: quick_mod_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
        };

        // 右親指の端の Enter: 長押しで音声入力（KoeType の Command+.）。確定のつもりの Enter が音声入力にならないよう長めに 0.3 秒。軽押しのすぐ後の押し続けは Enter の連続
        vbs: voice_enter {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "tap-preferred";
            tapping-term-ms = <300>;
            quick-tap-ms = <200>;
        };

        // 右親指の中央寄りの Delete（前方削除）: 長押しで記号と矢印の面。
        // 長押しして何も打たずに離しても Delete は出さない（文字が消えないように retro-tap なし）
        blt: delete_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <150>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q             &kp W     &kp E     &kp R              &kp T                                                                   &kp Y      &kp U  &lt 5 I    &kp O    &kp P
&kp A             &kp S     &kp D     &kp F              &kp G               &kp LEFT_BRACKET      &kp MINUS                     &kp H      &kp J  &kp K      &kp L    &kp SQT
&mt LEFT_SHIFT Z  &kp X     &kp C     &kp V              &kp B               &kp COLON             &kp SEMICOLON                   &kp N      &kp M  &kp COMMA  &kp DOT  &mt LEFT_SHIFT SLASH
&mo 3             &slt 1 ESC  &kp LC(SPACE)  &cmt LGUI TAB        &tmt LALT SPACE  &cmt LCTRL BACKSPACE &blt 2 DELETE             &vbs LG(PERIOD) ENTER                                 &kp DELETE
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        // 数字と F キーの面（X の真下の Esc の長押し）。数字は右手、F キーは左手
        NUM_F {
            bindings = <
&kp F1   &kp F2   &kp F3   &kp F4   &none                                                &kp MINUS      &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp PLUS
&kp F5   &kp F6   &kp F7   &kp F8   &none    &none                       &none           &kp SLASH      &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp ASTERISK
&kp F9   &kp F10  &kp F11  &kp F12  &none    &none                       &kp EQUAL       &kp KP_NUMBER_0  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp PERIOD
&trans   &trans   &trans   &trans   &trans   &trans                      &trans          &trans                                                              &trans
            >;
        };

        // 記号の面（右親指の外側の Delete の長押し）。動画の配列図の Layer 2 の並び（^ と _ は人差し指の内側、Home・End は下の段の内側）
        SYMBOL {
            bindings = <
&kp QUESTION  &kp EXCLAMATION   &kp AMPERSAND      &kp PIPE          &kp BACKSLASH                                                  &kp SLASH              &kp EQUAL          &kp ASTERISK      &kp PLUS          &kp PERCENT
&kp HASH      &kp GRAVE         &kp DOUBLE_QUOTES  &kp SINGLE_QUOTE  &kp TILDE             &kp CARET      &kp UNDERSCORE           &kp LEFT_ARROW         &kp DOWN_ARROW     &kp UP_ARROW      &kp RIGHT_ARROW   &kp COLON
&kp AT_SIGN   &kp LESS_THAN     &kp LEFT_BRACE     &kp LEFT_BRACKET  &kp LEFT_PARENTHESIS  &kp HOME       &kp END                  &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACKET  &kp RIGHT_BRACE   &kp GREATER_THAN  &kp DOLLAR
&trans        &trans            &trans             &trans            &kp DELETE            &trans         &trans                   &trans                                                                           &trans
            >;
        };

        // Mac 操作・メディアの面（Z の真下を押さえている間）。よく使うものは右手、めったに使わないものは左手。
        // 撮影は CleanShot の設定に合わせる（全画面 Shift+Cmd+3、範囲 4、まとめ 0、画面の文字 T）
        MAC_MEDIA {
            bindings = <
&none   &kp C_PREV    &kp C_PP      &kp C_NEXT    &kp LG(SLASH)                                     &kp C_BRI_DN       &kp C_BRI_UP        &kp C_VOL_DN      &kp C_VOL_UP         &kp C_MUTE
&none   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &none          &kp LC(LS(TAB))    &kp LC(LEFT_ARROW) &kp LC(DOWN_ARROW)  &kp LC(UP_ARROW)  &kp LC(RIGHT_ARROW)  &kp LC(TAB)
&none   &none         &none         &bt BT_CLR    &none         &bootloader    &kp LA(LS(LG(V)))  &kp LS(LG(N3))     &kp LS(LG(N4))      &kp LS(LG(N0))    &kp LS(LG(T))        &none
&trans  &trans        &trans        &trans        &trans        &trans         &trans             &trans                                                                   &trans
            >;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

    };
};

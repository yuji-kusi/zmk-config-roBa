#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

// 面の番号: 0 ふだん / 1 数字と F キー / 2 記号と矢印 / 3 Mac 操作・メディア / 4 マウス / 5 スクロール
// 入り方（どれも 1 つのキーの長押し）: 1 左親指の Space / 2 右下の角 / 3 C の真下
// 4 と 5 は &trackball の automouse-layer・scroll-layers が指しているので番号を変えない

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    automouse-layer = <4>;
    scroll-layers = <5>;
};

/ {
    behaviors {
        // 右親指の外側の Backspace: しっかり長く押したときだけ Option にする
        tmt: thumb_mod_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "tap-preferred";
            tapping-term-ms = <220>;
            quick-tap-ms = <150>;
            // 長く押しても他のキーを押さずに離したら Backspace として出す
            retro-tap;
        };

        // 左親指の Space: しっかり長く押したときだけ数字と F キーの面にする。
        // 文字を打った直後 0.15 秒以内の Space は必ず Space（速く打っているときに面へ入らない）
        slt: space_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <150>;
            retro-tap;
        };

        // 左親指の外側（軽押し Tab・長押し Command）と内側（軽押しで英数とかなの入れ替え＝Control+Space・長押し Control）。
        // Command+C などを素早く打てるよう balanced にする
        cmt: quick_mod_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
        };

        // 右親指の内側の Enter: 長押しで音声入力（KoeType の Command+.）。確定のつもりの Enter が音声入力にならないよう長めに 0.3 秒。軽押しのすぐ後の押し続けは Enter の連続
        vbs: voice_enter {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "tap-preferred";
            tapping-term-ms = <300>;
            quick-tap-ms = <200>;
        };

        // C の真下: 軽押し Esc、長押しで Mac 操作・メディアの面
        xlt: esc_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            // 長めに押しても他のキーを押さずに離したら Esc として出す
            retro-tap;
        };

        // 右下の角: 軽押し F7、長押しで記号と矢印の面。
        // 押さえたまま別のキーを押して離したら面に入る（角を短く押して矢印を打っても F7 が出ない）
        tlt: thumb_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <220>;
            quick-tap-ms = <150>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q             &kp W     &kp E     &kp R              &kp T                                                                   &kp Y      &kp U  &lt 5 I    &kp O    &kp P
&kp A             &kp S     &kp D     &kp F              &kp G               &kp LEFT_BRACKET      &kp MINUS                     &kp H      &kp J  &kp K      &kp L    &kp SQT
&mt LEFT_SHIFT Z  &kp X     &kp C     &kp V              &kp B               &kp COLON             &kp SEMICOLON                 &kp N      &kp M  &kp COMMA  &kp DOT  &mt LEFT_SHIFT SLASH
&kp LCTRL         &kp LGUI  &xlt 3 ESC &cmt LGUI TAB      &slt 1 SPACE        &cmt LCTRL LC(SPACE)  &vbs LG(PERIOD) ENTER         &tmt LALT BACKSPACE                           &tlt 2 F7
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        // 数字と F キーの面（左親指の Space の長押し）。数字は右手、F キーは左手
        NUM_F {
            bindings = <
&kp F1   &kp F2   &kp F3   &kp F4   &none                                                &kp MINUS      &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp PLUS
&kp F5   &kp F6   &kp F7   &kp F8   &none    &none                       &none           &kp SLASH      &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp ASTERISK
&kp F9   &kp F10  &kp F11  &kp F12  &none    &none                       &kp EQUAL       &kp KP_NUMBER_0  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp PERIOD
&trans   &trans   &trans   &trans   &trans   &trans                      &trans          &trans                                                              &trans
            >;
        };

        // 記号と矢印の面（右下の角の長押し）。押さえている右小指の列（P・'・/ の位置）には、他の面にもある記号だけを置く
        SYMBOL {
            bindings = <
&kp QUESTION  &kp EXCLAMATION   &kp AMPERSAND      &kp PIPE          &kp BACKSLASH                                                  &kp PERCENT            &kp DOLLAR         &kp ASTERISK      &kp PLUS          &kp EQUAL  
&kp HASH      &kp GRAVE         &kp DOUBLE_QUOTES  &kp SINGLE_QUOTE  &kp TILDE             &kp CARET      &kp UNDERSCORE           &kp LEFT_ARROW         &kp DOWN_ARROW     &kp UP_ARROW      &kp RIGHT_ARROW   &kp COLON
&kp AT_SIGN   &kp LESS_THAN     &kp LEFT_BRACE     &kp LEFT_BRACKET  &kp LEFT_PARENTHESIS  &kp HOME       &kp END                  &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACKET  &kp RIGHT_BRACE   &kp GREATER_THAN  &kp SLASH 
&trans        &trans            &trans             &trans            &kp DELETE            &trans         &trans                   &trans                                                                           &trans
            >;
        };

        // Mac 操作・メディアの面（C の真下の長押し）
        MAC_MEDIA {
            bindings = <
&kp C_BRI_DN       &kp C_BRI_UP  &kp C_MUTE    &kp C_VOL_DN  &kp C_VOL_UP                                     &none               &kp C_PREV          &kp C_PP          &kp C_NEXT           &kp LG(SLASH)
&kp LA(LS(LG(V)))  &mkp MB1      &mkp MB3      &mkp MB2      &kp LS(LG(T))  &kp LC(LG(H))      &kp LC(LS(TAB))  &kp LC(LEFT_ARROW)  &kp LC(DOWN_ARROW)  &kp LC(UP_ARROW)  &kp LC(RIGHT_ARROW)  &kp LC(TAB)
&bt BT_SEL 0       &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &none          &bt BT_CLR         &none            &kp LS(LG(N3))      &kp LS(LG(N4))      &kp LS(LG(N0))    &none                &bootloader
&trans             &trans        &trans        &trans        &trans         &trans             &trans           &trans                                                                         &trans
            >;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };
    };
};

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

// 面の番号: 0 ふだん / 1 数字と F キー / 2 記号と矢印 / 3 Mac 操作・メディア / 4 マウス / 5 スクロール
// 4 と 5 は &trackball の automouse-layer・scroll-layers が指しているので番号を変えない
// 親指は串田さんの呼び方に合わせる: 「外側」＝中央寄り（斜めに傾いたキー）。
// 左親指 中央寄りから前方削除（Delete）・Space・Tab、右親指 中央寄りから delete（Backspace）・Enter
// スクロール: I の長押し、または右下の角（前方削除）の長押しをしながらボール
// 入り方: 1 右親指の delete（Backspace）の長押し / 2 右親指の Enter の長押し / 3 Z の真下を押さえている間

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    automouse-layer = <4>;
    scroll-layers = <5>;
};

/ {
    behaviors {
        // ホームの段の長押しで修飾キーの束（単体の Control・Option・Command は親指にある）。
        // 左 A Shift・S Control+Option+Command・D Command+Shift・F Control+Option、右はその鏡（J Control+Option・K Command+Shift・L Control+Option+Command・' Shift）。
        // F を押さえて Space で Orca の会話開始（Control+Option+Space）、K を押さえて T・4 で CleanShot の撮影など
        // 速打ちで誤って働かないように: 文字を打った直後 0.15 秒以内は必ず文字、0.25 秒押さえたうえで反対の手のキー（と親指）を押したときだけ修飾キー
        lhs: left_home_shift {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <250>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <5 6 7 8 9 16 17 18 19 20 21 28 29 30 31 32 33 37 38 39 40 41 42>;
            hold-trigger-on-release;
        };

        rhs: right_home_shift {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <250>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 15 22 23 24 25 26 27 34 35 36 37 38 39 40 41 42>;
            hold-trigger-on-release;
        };

        // 左親指の真ん中の Space: しっかり長く押したときだけ Option にする
        tmt: thumb_mod_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "tap-preferred";
            tapping-term-ms = <220>;
            quick-tap-ms = <150>;
            // 長く押しても他のキーを押さずに離したら Space として出す
            retro-tap;
        };

        // 左親指の中央寄り（軽押し 前方削除・長押し Command）といちばん端（軽押し Tab・長押し Control）。
        // Command+C などを素早く打てるよう balanced にする。軽押しのすぐ後の押し続けは前方削除の連続
        cmt: quick_mod_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
        };

        // 内側の列の 2 役キー（N の左隣: 軽押し 音声入力・長押し ;、B の右隣: 軽押し 取り消し・長押し やり直し）。
        // めったに使わない側を長押しにし、0.3 秒としっかり長めにする
        vbs: slow_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "tap-preferred";
            tapping-term-ms = <300>;
            quick-tap-ms = <200>;
        };

        // 右親指の面の切り替え: delete（Backspace）の長押しで数字と F キーの面、Enter の長押しで記号と矢印の面。
        // 長押しして何も打たずに離しても delete・Enter は出さない（文字を消さない・誤って送信しない）
        blt: right_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <150>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q             &kp W     &kp E     &kp R              &kp T                                                                   &kp Y      &kp U  &lt 5 I    &kp O    &kp P
&lhs LSHIFT A     &lhs LC(LA(LGUI)) S &lhs LG(LSHIFT) D &lhs LC(LALT) F            &kp G               &kp LC(UP_ARROW)      &kp MINUS                     &kp H      &rhs LC(LALT) J  &rhs LG(LSHIFT) K  &rhs LC(LA(LGUI)) L  &rhs LSHIFT SQT
&kp Z             &kp X     &kp C     &kp V              &kp B               &vbs LS(LG(Z)) LG(Z)  &vbs SEMICOLON LG(PERIOD)    &kp N      &kp M  &kp COMMA  &kp DOT  &kp SLASH
&mo 3             &kp ESC     &kp LC(SPACE)  &cmt LCTRL TAB       &tmt LALT SPACE  &cmt LGUI DELETE     &blt 1 BACKSPACE          &blt 2 ENTER                                        &lt 5 DELETE
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        // 数字と F キーの面（右親指の delete の長押し）。数字は上の段に横一列、F キーは左手（Mac ではあまり使わないので）
        NUM_F {
            bindings = <
&kp N1   &kp N2   &kp N3   &kp N4   &kp N5                                                &kp N6     &kp N7     &kp N8        &kp N9    &kp N0
&kp F1   &kp F2   &kp F3   &kp F4   &kp F5   &kp F6                      &none            &kp MINUS  &kp PLUS   &kp ASTERISK  &kp SLASH &kp EQUAL
&kp F7   &kp F8   &kp F9   &kp F10  &kp F11  &kp F12                     &none            &none      &none      &kp COMMA     &kp DOT   &none
&trans   &trans   &trans   &trans   &trans   &trans                      &trans           &trans                                       &trans
            >;
        };

        // 記号と矢印の面（右親指の Enter の長押し）。動画の配列図の Layer 2 の並び（^ と _ は人差し指の内側、Home・End は下の段の内側）
        SYMBOL {
            bindings = <
&kp QUESTION  &kp EXCLAMATION   &kp AMPERSAND      &kp PIPE          &kp BACKSLASH                                                  &kp SLASH              &kp EQUAL          &kp ASTERISK      &kp PLUS          &kp PERCENT
&kp HASH      &kp GRAVE         &kp DOUBLE_QUOTES  &kp SINGLE_QUOTE  &kp TILDE             &kp CARET      &kp UNDERSCORE           &kp LEFT_ARROW         &kp DOWN_ARROW     &kp UP_ARROW      &kp RIGHT_ARROW   &kp COLON
&kp AT_SIGN   &kp LESS_THAN     &kp LEFT_BRACE     &kp LEFT_BRACKET  &kp LEFT_PARENTHESIS  &kp HOME       &kp END                  &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACKET  &kp RIGHT_BRACE   &kp GREATER_THAN  &kp DOLLAR
&trans        &trans            &trans             &trans            &kp DELETE            &trans         &trans                   &trans                                                                           &trans
            >;
        };

        // Mac 操作・メディアの面（Z の真下を押さえている間）。よく使うものは右手、めったに使わないものは左手。
        // 撮影は CleanShot の設定に合わせる（全画面 Shift+Cmd+3、範囲 4、まとめ 0、画面の文字 T）
        MAC_MEDIA {
            bindings = <
&none   &kp C_PREV    &kp C_PP      &kp C_NEXT    &kp LG(SLASH)                                     &kp C_BRI_DN       &kp C_BRI_UP        &kp C_VOL_DN      &kp C_VOL_UP         &kp C_MUTE
&none   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &none          &kp LC(LS(TAB))    &kp LC(LEFT_ARROW) &kp LC(DOWN_ARROW)  &kp LC(UP_ARROW)  &kp LC(RIGHT_ARROW)  &kp LC(TAB)
&none   &none         &none         &bt BT_CLR    &none         &bootloader    &kp LA(LS(LG(V)))  &kp LS(LG(N3))     &kp LS(LG(N4))      &kp LS(LG(N0))    &kp LS(LG(T))        &none
&trans  &trans        &trans        &trans        &trans        &trans         &trans             &trans                                                                   &trans
            >;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

    };
};
